# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/xaydunghuuvong

# ============================================
# Authentication
# ============================================
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-this-to-another-random-string-at-least-32-characters
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Quản lý Vận chuyển"
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================
# Demo Seed Data (only for seeding, not production)
# ============================================
DEMO_PASSWORD=Demo@123456

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MINUTES=15

# ============================================
# Storage (Optional - for file uploads)
